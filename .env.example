# --- Option A: Local SQLite (default, works offline) ---
DATABASE_URL="file:./dev.db"

# --- Option B: Vercel Postgres 1GB (same data local + live — copy from Vercel Storage) ---
# DATABASE_URL="postgresql://..."   # POSTGRES_PRISMA_URL
# DIRECT_URL="postgresql://..."     # POSTGRES_URL_NON_POOLING

# Required in production — long random string (session cookie signing)
SESSION_SECRET="replace-with-long-random-secret"

NEXT_PUBLIC_SITE_URL="https://www.dprlogistics.in"

# Contact / Quote form emails
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-user@example.com"
SMTP_PASS="your-gmail-app-password"
MAIL_TO="ops@example.com"
MAIL_FROM="DPR Logistics <noreply@example.com>"

# Device / SIM tracking ingest (required in production)
TRACKING_INGEST_KEY="replace-with-long-random-ingest-key"

# SIM network tracking
SIM_TRACK_PROVIDER="mock"
SIM_TRACK_POLL_MINUTES="5"
