# Vercel Postgres — use the SAME URLs locally and on Vercel (Storage → Postgres → .env.local)
# Pooled URL (app queries):
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
# Direct URL (migrations):
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Or use Vercel auto env names (scripts resolve these too):
# POSTGRES_PRISMA_URL=
# POSTGRES_URL_NON_POOLING=
# POSTGRES_URL=

NEXT_PUBLIC_SITE_URL="https://www.dprlogistics.in"

# Contact / Quote form emails
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="dprlogistics2142@gmail.com"
SMTP_PASS="your-gmail-app-password"
MAIL_TO="dprlogistics2142@gmail.com"
MAIL_FROM="DPR Logistics <dprlogistics2142@gmail.com>"

# SIM network tracking
SIM_TRACK_PROVIDER="mock"
SIM_TRACK_POLL_MINUTES="5"
